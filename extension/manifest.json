{
  "manifest_version": 3,
  "key": "",
  "name": "Odradek Autofill",
  "version": "0.5.0",
  "minimum_chrome_version": "141",
  "description": "A versatile assistant that helps you review and complete job application forms.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "commands": {
    "fill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the application form on this page"
    }
  },
  "icons": {
    "16": "icons/odradek-16.png",
    "32": "icons/odradek-32.png",
    "48": "icons/odradek-48.png",
    "128": "icons/odradek-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/odradek-16.png",
      "32": "icons/odradek-32.png",
      "48": "icons/odradek-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true
    }
  ]
}
