<?xml version="1.0" encoding="utf-8"?>
<!-- Libera no nuget.org só os pacotes desta solução e suas dependências (o NuGet.Config global do usuário bloqueia o resto).
     Esta seção parece substituir o mapeamento global, por isso lista também o que ele já liberava (SQLitePCLRaw, Sqlite.Core).
     Lista aprovada pelo usuário em 2026-11-23, só Windows: calculada pela API pública do nuget.org (dono conferido).
     Pacote novo só entra aqui com aprovação, depois de conferir o dono. Não acrescentar em loop a partir de erros de restore. -->
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- diretos: Odradek.Core -->
      <package pattern="Dapper" />
      <package pattern="Microsoft.Data.Sqlite" />
      <package pattern="PdfPig" />
      <!-- aprovados em 2026-11-24 para o backup no Postgres: Npgsql 10.0.4 (donos npgsql/roji) e as duas dependências dele no net10.0 (Microsoft) -->
      <package pattern="Npgsql" />
      <package pattern="Microsoft.Extensions.Logging.Abstractions" />
      <package pattern="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <!-- diretos: Odradek.App -->
      <package pattern="Avalonia" />
      <package pattern="Avalonia.Skia" />
      <package pattern="Avalonia.Themes.Fluent" />
      <package pattern="Avalonia.Win32" />
      <package pattern="CommunityToolkit.Mvvm" />
      <!-- dependências -->
      <package pattern="Avalonia.Angle.Windows.Natives" />
      <package pattern="Avalonia.BuildServices" />
      <package pattern="Avalonia.Remote.Protocol" />
      <package pattern="Avalonia.HarfBuzz" />
      <package pattern="HarfBuzzSharp" />
      <package pattern="HarfBuzzSharp.NativeAssets.Linux" />
      <package pattern="HarfBuzzSharp.NativeAssets.macOS" />
      <package pattern="HarfBuzzSharp.NativeAssets.WebAssembly" />
      <package pattern="HarfBuzzSharp.NativeAssets.Win32" />
      <package pattern="MicroCom.Runtime" />
      <package pattern="Microsoft.Data.Sqlite.Core" />
      <package pattern="SkiaSharp" />
      <package pattern="SkiaSharp.NativeAssets.Linux" />
      <package pattern="SkiaSharp.NativeAssets.macOS" />
      <package pattern="SkiaSharp.NativeAssets.WebAssembly" />
      <package pattern="SkiaSharp.NativeAssets.Win32" />
      <package pattern="SQLitePCLRaw.bundle_e_sqlite3" />
      <package pattern="SQLitePCLRaw.core" />
      <package pattern="SQLitePCLRaw.lib.e_sqlite3" />
      <package pattern="SQLitePCLRaw.provider.e_sqlite3" />
      <package pattern="System.Buffers" />
      <package pattern="System.Memory" />
      <package pattern="System.Numerics.Vectors" />
      <package pattern="System.Runtime.CompilerServices.Unsafe" />
      <!-- testes (aprovado pelo usuário em 2026-11-23, "aprove o xunit também"): diretos em tests/Odradek.Core.Tests; donos conferidos no nuget.org
           (xunit; Microsoft/vstest/dotnetframework; Newtonsoft/JamesNK). coverlet.collector NÃO foi aprovado. -->
      <package pattern="xunit" />
      <package pattern="xunit.runner.visualstudio" />
      <package pattern="Microsoft.NET.Test.Sdk" />
      <package pattern="xunit.core" />
      <package pattern="xunit.assert" />
      <package pattern="xunit.analyzers" />
      <package pattern="xunit.extensibility.core" />
      <package pattern="xunit.extensibility.execution" />
      <package pattern="xunit.abstractions" />
      <package pattern="Microsoft.TestPlatform.TestHost" />
      <package pattern="Microsoft.TestPlatform.ObjectModel" />
      <package pattern="Microsoft.CodeCoverage" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="System.Reflection.Metadata" />
      <package pattern="System.Collections.Immutable" />
      <!-- runtimes que o publish self-contained win-x64 leva junto (aprovados pelo usuário em 2026-11-25; donos conferidos no nuget.org: Microsoft/dotnetframework/aspnet, verificados) -->
      <package pattern="Microsoft.NETCore.App.Runtime.win-x64" />
      <package pattern="Microsoft.AspNetCore.App.Runtime.win-x64" />
      <package pattern="Microsoft.WindowsDesktop.App.Runtime.win-x64" />
    </packageSource>
  </packageSourceMapping>
</configuration>
