<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:Odradek.Core.Data;assembly=Odradek.Core"
        xmlns:local="clr-namespace:Odradek.App"
        x:Class="Odradek.App.MainWindow"
        Title="Odradek"
        Width="1280" Height="860" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="BorderOnly">
  <Grid ColumnDefinitions="248,*" RowDefinitions="32,*">
    <!-- Barra lateral -->
    <Border x:Name="Sidebar" Grid.Column="0" Grid.RowSpan="2" Background="{DynamicResource SidebarBg}" Padding="14,18,14,14">
      <Grid RowDefinitions="Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="6,0,0,18">
          <Image Source="avares://Odradek/Assets/odradek-128.png" Width="32" Height="32" Margin="4" RenderOptions.BitmapInterpolationMode="HighQuality" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Odradek" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="coleta · triagem · candidaturas" Classes="muted" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <ListBox x:Name="NavList" Classes="nav">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:NavItem">
                  <Grid ColumnDefinitions="Auto,*,Auto" Background="Transparent" ToolTip.Tip="{Binding Hint}">
                    <TextBlock Classes="glyph" Text="{Binding Glyph}" Width="20" TextAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <!-- contador (vagas para revisar, em "Vagas") -->
                    <Border Grid.Column="2" Classes="badge" MinWidth="22" Padding="6,1" Background="{DynamicResource Accent}" IsVisible="{Binding HasBadge}">
                      <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="VAGAS POR STATUS" Classes="muted" FontSize="11" FontWeight="SemiBold" Margin="10,18,0,4" />
            <ItemsControl x:Name="CountsList" Margin="10,0,6,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:CountRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <TextBlock Text="{Binding Label}" Classes="muted" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="13" FontWeight="SemiBold" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Classes="card" Padding="12" Margin="0,12,0,0">
          <StackPanel Spacing="8">
            <TextBlock Text="Coleta de vagas" Classes="h2" />
            <TextBlock x:Name="CollectorText" TextWrapping="Wrap" Classes="muted" Text="Coleta parada" />
            <Button x:Name="CollectorButton" Classes="icon primary" Content="Iniciar coleta" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"  Tag="&#xE768;"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Spacing="10" Margin="0,10,0,0">
          <Grid ColumnDefinitions="Auto,*" Margin="4,0,0,0">
            <TextBlock Text="Tema" Classes="muted" VerticalAlignment="Center" Margin="0,0,10,0" />
            <ComboBox x:Name="ThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" />
          </Grid>
          <StackPanel Spacing="2">
            <!-- O recado da atualização ("Nova versão…", "Procurando…") só ocupa linha quando existe -->
            <TextBlock x:Name="UpdateText" Classes="muted" FontSize="11" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding #UpdateText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <!-- A versão em uso (sempre visível; dá para selecionar e copiar) e, na mesma linha, a atualização (só no app instalado) -->
            <Grid ColumnDefinitions="*,Auto" MinHeight="22">
              <SelectableTextBlock x:Name="VersionText" Classes="muted" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center" />
              <Button x:Name="UpdateButton" Grid.Column="1" Classes="quiet" Content="Buscar atualização" Padding="4,2"
                      VerticalAlignment="Center" VerticalContentAlignment="Center" IsVisible="False" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Conteúdo -->
    <Grid x:Name="ContentHost" Grid.Column="1" Grid.Row="1" Background="Transparent" Margin="0,0,0,14" RowDefinitions="Auto,Auto,Auto,*">
      <StackPanel Grid.Row="0" Spacing="4" Margin="28,20,28,0">
        <TextBlock x:Name="StartupText" IsVisible="False" />
        <Border Classes="notice" Margin="0,0,0,12" IsVisible="{Binding #NoticeText.IsVisible}">
          <TextBlock x:Name="NoticeText" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="False" />
        </Border>
      </StackPanel>
      <Grid x:Name="HeaderGrid" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="28,0,28,14">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="JobsTitle" Text="Vale a pena olhar" Classes="h1" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="JobsSubtitle" Classes="muted" IsVisible="False" Margin="0,2,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" x:Name="JobsControls" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Classes="field">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph muted" Text="&#xE8FD;" FontSize="14" />
              <ComboBox x:Name="StatusBox" Classes="bare" MinWidth="150" />
            </StackPanel>
          </Border>
          <Border Classes="field">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph muted" Text="&#xE8CB;" FontSize="14" />
              <ComboBox x:Name="SortBox" Classes="bare" MinWidth="120" />
            </StackPanel>
          </Border>
          <Border Classes="field pager">
            <StackPanel Orientation="Horizontal">
              <Button x:Name="PrevButton" Classes="page" Content="&#xE76B;" Tag="glyph" />
              <TextBlock x:Name="PageText" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Classes="muted" />
              <Button x:Name="NextButton" Classes="page" Content="&#xE76C;" Tag="glyph" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="2" x:Name="FilterHost" Spacing="0" Margin="28,0,28,4">
        <WrapPanel x:Name="FilterBar">
          <Border x:Name="SearchField" Classes="field" Width="300" Margin="0,0,8,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Classes="glyph muted" Text="&#xE721;" FontSize="14" Margin="0,0,8,0" />
              <TextBox x:Name="SearchBox" Grid.Column="1" Classes="bare" PlaceholderText="Buscar título, empresa ou local" />
              <Button x:Name="SearchClearButton" Grid.Column="2" Classes="tiny" Content="&#xE894;" IsVisible="False" />
            </Grid>
          </Border>
          <Border Classes="field" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="glyph muted" Text="&#xE734;" FontSize="14" />
              <ComboBox x:Name="MinBox" Classes="bare" MinWidth="120" />
            </StackPanel>
          </Border>
          <Border Classes="field" Margin="0,0,8,8">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <CalendarDatePicker x:Name="DateFromBox" Classes="bare" Watermark="De" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" Width="128" />
              <TextBlock Classes="glyph muted" Text="&#xE76C;" FontSize="11" />
              <CalendarDatePicker x:Name="DateToBox" Classes="bare" Watermark="Até" SelectedDateFormat="Custom" CustomDateFormatString="dd/MM/yyyy" Width="128" />
            </StackPanel>
          </Border>
          <Button x:Name="ClearFiltersButton" Classes="quiet icon" Tag="&#xE894;" Content="Limpar filtros" IsVisible="False" Margin="0,0,8,8" VerticalAlignment="Top" Height="36" />
          <Button x:Name="ReviewedButton" Content="Marcar página como conferida" IsVisible="False" Margin="0,0,8,8"  Classes="icon" Tag="&#xE73E;"/>
          <Button x:Name="PurgeIgnoredButton" Content="Limpar ignoradas" IsVisible="False" Margin="0,0,8,8" Classes="icon danger" Tag="&#xE74D;" />
          <Button x:Name="PurgeIgnoredCancel" Content="Cancelar" IsVisible="False" Margin="0,0,8,8" />
        </WrapPanel>
        <Expander x:Name="BulkExpander" Header="Ignorar em lote" IsVisible="False" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <WrapPanel>
              <TextBox x:Name="BulkCountry" PlaceholderText="País (ex.: Brazil)" MinWidth="150" Margin="0,0,8,8" />
              <TextBox x:Name="BulkFoundFrom" PlaceholderText="Encontrada de" MinWidth="120" Margin="0,0,8,8" />
              <TextBox x:Name="BulkFoundTo" PlaceholderText="Encontrada até" MinWidth="120" Margin="0,0,8,8" />
              <TextBox x:Name="BulkPostedFrom" PlaceholderText="Publicada de" MinWidth="120" Margin="0,0,8,8" />
              <TextBox x:Name="BulkPostedTo" PlaceholderText="Publicada até" MinWidth="120" Margin="0,0,8,8" />
              <TextBox x:Name="BulkMatchMin" PlaceholderText="Match mín." MinWidth="90" Margin="0,0,8,8" />
              <TextBox x:Name="BulkMatchMax" PlaceholderText="Match máx." MinWidth="90" Margin="0,0,8,8" />
            </WrapPanel>
            <CheckBox x:Name="BulkAll" Content="Ignorar todas as vagas em revisão" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="BulkPreviewButton" Content="Ver quantidade"  Classes="icon" Tag="&#xE721;"/>
              <TextBlock x:Name="BulkPreviewText" VerticalAlignment="Center" />
              <Button x:Name="BulkApplyButton" Classes="danger" IsVisible="False" />
              <local:HelpMark Text="Afeta somente vagas em “Vale a pena olhar”. País procura o texto na localização da vaga. Datas no formato AAAA-MM-DD." />
            </StackPanel>
          </StackPanel>
        </Expander>
      </StackPanel>

      <!-- Logs -->
      <Grid Grid.Row="3" x:Name="LogsPane" Classes="page" IsVisible="False" RowDefinitions="Auto,*" Margin="28,0">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
          <Button x:Name="LogsRefreshButton" Content="Atualizar"  Classes="icon" Tag="&#xE72C;"/>
          <Button x:Name="LogsCopyButton" Content="Copiar log inteiro" Classes="icon" Tag="&#xE8C8;"/>
          <Button x:Name="LogsClearButton" Classes="icon danger" Content="Limpar logs"  Tag="&#xE74D;"/>
          <Button x:Name="LogsClearCancel" Content="Cancelar" IsVisible="False" />
        </StackPanel>
        <Border Grid.Row="1" Classes="card" Padding="6">
          <Grid>
            <ListBox x:Name="LogsList" Classes="log" Background="Transparent" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="d:LogEntry">
                  <Grid ColumnDefinitions="118,72,110,*">
                    <SelectableTextBlock ContextFlyout="{x:Null}" Text="{Binding CreatedAt, Converter={x:Static local:Palette.LogTime}}" Classes="muted" FontFamily="Cascadia Mono, Consolas" />
                    <TextBlock Grid.Column="1" Text="{Binding Level}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"
                               Foreground="{Binding Level, Converter={x:Static local:Palette.LevelForeground}}" />
                    <SelectableTextBlock ContextFlyout="{x:Null}" Grid.Column="2" Text="{Binding Source}" Classes="muted" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <SelectableTextBlock ContextFlyout="{x:Null}" Grid.Column="3" Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="LogsEmpty" Text="Carregando…" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
          </Grid>
        </Border>
      </Grid>

      <!-- Filas: uma subaba para a fila de IA (banco) e outra para as vagas do LinkedIn que a extensão mandou -->
      <TabControl Grid.Row="3" x:Name="QueueTabs" Classes="page" IsVisible="False" Margin="28,0">
        <TabItem x:Name="QueueAiTab" Header="Processamento de IA">
          <!-- botões em cima, lista à esquerda, detalhe (decisão, histórico, checklist) à direita -->
          <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,12,1.3*" Margin="0,8,0,0">
            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
              <Button x:Name="QueueEvaluateButton" Classes="icon primary" Content="Triar vagas novas"  Tag="&#xE9D9;"/>
              <Button x:Name="QueueRetryAllButton" Content="Reenfileirar falhas"  Classes="icon" Tag="&#xE72C;"/>
              <Button x:Name="QueueClearButton" Classes="icon danger" Content="Limpar concluídos"  Tag="&#xE74D;"/>
              <Button x:Name="QueueClearCancel" Content="Cancelar" IsVisible="False" />
              <local:HelpMark Text="Cada vaga nova entra aqui. A IA a compara com os seus currículos e a manda para “Vale a pena olhar” ou para as descartadas. Falhas são tentadas de novo até o limite de tentativas." />
            </StackPanel>
            <Grid Grid.Row="1">
              <ListBox x:Name="QueueList" Classes="cards">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:QueueRow">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="QueueEmpty" Text="Carregando…" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Border Grid.Row="1" Grid.Column="2" Classes="card">
              <ScrollViewer>
                <StackPanel Spacing="10">
                  <TextBlock x:Name="QueueDetailTitle" Classes="h2" FontSize="18" TextWrapping="Wrap" Text="Selecione um item da fila" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="QueueOpenButton" Content="Abrir vaga" IsVisible="False"  Classes="icon" Tag="&#xE8A7;"/>
                    <Button x:Name="QueueCancelButton" Classes="icon danger" Content="Cancelar item" IsVisible="False"  Tag="&#xE711;"/>
                    <Button x:Name="QueueRetryButton" Classes="icon primary" Content="Reenfileirar item" IsVisible="False"  Tag="&#xE72C;"/>
                  </StackPanel>
                  <SelectableTextBlock x:Name="QueueDetailBody" TextWrapping="Wrap" LineHeight="21" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>
        <TabItem x:Name="QueueLinkedInTab" Header="Vagas do LinkedIn">
          <!-- mesmo desenho: botões em cima, lista à esquerda, estado da fila e detalhe à direita -->
          <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,12,1.3*" Margin="0,8,0,0">
            <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10" MinHeight="36">
              <Button x:Name="LinkedInResumeButton" Classes="icon primary" Content="Retomar agora" IsVisible="False" Tag="&#xE768;"/>
              <Button x:Name="LinkedInClearButton" Classes="icon danger" Content="Esvaziar fila" Tag="&#xE74D;"/>
              <Button x:Name="LinkedInClearCancel" Content="Cancelar" IsVisible="False" />
              <local:HelpMark Text="A extensão envia as vagas e o Odradek lê a página pública de cada uma, importa e manda para a triagem. Se o LinkedIn pedir calma, a fila espera e continua sozinha. Os contadores e o histórico valem desde que o app foi aberto." />
            </StackPanel>
            <Grid Grid.Row="1">
              <ListBox x:Name="LinkedInList" Classes="cards">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:LinkedInRow">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Subtitle}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="LinkedInEmpty" Text="Nenhuma vaga enviada pela extensão nesta sessão." Classes="muted" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Border Grid.Row="1" Grid.Column="2" Classes="card">
              <ScrollViewer>
                <StackPanel Spacing="10">
                  <TextBlock Text="Estado da fila" Classes="h2" />
                  <TextBlock x:Name="LinkedInStateText" TextWrapping="Wrap" LineHeight="21" />
                  <TextBlock x:Name="LinkedInDetailTitle" Classes="h2" FontSize="18" TextWrapping="Wrap" Margin="0,10,0,0" Text="Selecione uma vaga da fila" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="LinkedInOpenButton" Content="Abrir no LinkedIn" IsVisible="False" Classes="icon" Tag="&#xE8A7;"/>
                    <Button x:Name="LinkedInViewJobButton" Content="Ver vaga" IsVisible="False" Classes="icon primary" Tag="&#xE8FD;"/>
                  </StackPanel>
                  <SelectableTextBlock x:Name="LinkedInDetailBody" TextWrapping="Wrap" LineHeight="21" />
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>

      <!-- Currículos (montado em código) -->
      <ScrollViewer Grid.Row="3" x:Name="ResumesPane" Classes="page" IsVisible="False" Margin="28,0"><StackPanel x:Name="ResumesHost" Spacing="12" MaxWidth="900" HorizontalAlignment="Left" /></ScrollViewer>
      <!-- Visão geral (montada em código a partir do resumo do banco) -->
      <ScrollViewer Grid.Row="3" x:Name="OverviewPane" Classes="page" IsVisible="False" Margin="28,0"><StackPanel x:Name="OverviewHost" Spacing="14" MaxWidth="1000" HorizontalAlignment="Left" /></ScrollViewer>

      <!-- Uso e cotas -->
      <ScrollViewer Grid.Row="3" x:Name="UsagePane" Classes="page" IsVisible="False" Margin="28,0">
        <StackPanel Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Apify — consumo do ciclo" Classes="h2" />
              <TextBlock x:Name="ApifyText" TextWrapping="Wrap" />
              <ProgressBar x:Name="ApifyBar" Minimum="0" Maximum="100" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="TokenHarbor" Classes="h2" />
              <TextBlock x:Name="TokenHarborText" TextWrapping="Wrap" />
              <ProgressBar x:Name="TokenHarborBar" Minimum="0" Maximum="100" IsVisible="False" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Backup na nuvem" Classes="h2" />
                <local:HelpMark Text="Roda uma vez por dia e ao sair do app. O destino é configurado em Configurações › Contas e chaves." />
              </StackPanel>
              <TextBlock x:Name="BackupText" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="Banco de dados local" Classes="h2" />
              <TextBlock x:Name="StorageText" TextWrapping="Wrap" LineHeight="22" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CompactButton" Classes="icon" Content="Compactar banco" Tag="&#xE72C;"/>
                <Button x:Name="CompactCancel" Content="Cancelar" IsVisible="False" />
                <local:HelpMark Text="Devolve ao disco o espaço livre que ficou dentro do banco." />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="AiTitle" Classes="h2" />
                <local:HelpMark Text="Estimativa local, só das chamadas feitas por este aplicativo." />
              </StackPanel>
              <TextBlock x:Name="AiText" TextWrapping="Wrap" LineHeight="22" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Assistente: pergunta de formulário → resposta pronta para colar (perfil + currículos analisados) -->
      <Grid Grid.Row="3" x:Name="AssistantPane" Classes="page" IsVisible="False" RowDefinitions="*,Auto" MaxWidth="760" HorizontalAlignment="Left" Margin="28,0">
        <ScrollViewer x:Name="AssistantScroll">
          <StackPanel x:Name="AssistantHost" Spacing="8">
            <TextBlock x:Name="AssistantEmpty" Text="Cole a pergunta de um formulário para receber uma resposta pronta." TextWrapping="Wrap" Classes="muted" Margin="0,24,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,8,0,0">
          <TextBox x:Name="AssistantInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" MaxHeight="200" MaxLength="4000"
                   PlaceholderText="Ex.: Quantos anos de experiência você tem com Python?" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="AssistantSendButton" Classes="icon primary" Content="Enviar pergunta"  Tag="&#xE724;"/>
            <Button x:Name="AssistantClearButton" Content="Nova conversa"  Classes="icon" Tag="&#xE8BB;"/>
            <local:HelpMark Text="A resposta usa o seu perfil e os currículos analisados. Ctrl+Enter também envia." />
            <TextBlock x:Name="AssistantState" VerticalAlignment="Center" Classes="muted" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Configurações: 4 abas editáveis com rascunho -->
      <TabControl Grid.Row="3" x:Name="SettingsTabs" Classes="page" IsVisible="False" Margin="28,0" />

      <!-- Vagas -->
      <Grid Grid.Row="3" x:Name="JobsPane" Classes="page" ColumnDefinitions="*,12,1.1*" Margin="28,0">
        <Grid>
          <ListBox x:Name="JobsList" Classes="rows" Margin="0,0,6,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="d:JobRecord">
                <Grid ColumnDefinitions="34,12,*" RowDefinitions="Auto,Auto,Auto">
                  <!-- anel da nota: trilha + arco proporcional (cor pela faixa da nota) -->
                  <Grid Grid.RowSpan="3" Width="34" Height="34" VerticalAlignment="Top">
                    <Ellipse Stroke="{DynamicResource NeutralSoft}" StrokeThickness="3" />
                    <Arc StartAngle="-90" SweepAngle="{Binding MatchScore, Converter={x:Static local:Palette.ScoreSweep}}" StrokeThickness="3" StrokeLineCap="Round"
                         Stroke="{Binding MatchScore, Converter={x:Static local:Palette.ScoreForeground}}" />
                    <TextBlock Text="{Binding MatchScore, Converter={x:Static local:Palette.ScoreText}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto" Margin="0,1,0,0">
                    <TextBlock Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                      <Run Text="{Binding Company}" /><Run Text=" · " /><Run Text="{Binding Location}" /><Run Text=" · " /><Run Text="{Binding Source, Converter={x:Static local:Palette.SourceLabel}}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                      <Button Classes="row primary" Content="Candidatar" Tag="applied" IsVisible="{Binding Status, Converter={x:Static local:Palette.CanApply}}" />
                      <Button Classes="row" Content="Salvar" Tag="saved" IsVisible="{Binding Status, Converter={x:Static local:Palette.CanSave}}" />
                      <Button Classes="row ghost" Content="Ignorar" Tag="ignored" IsVisible="{Binding Status, Converter={x:Static local:Palette.CanIgnore}}" />
                    </StackPanel>
                  </Grid>
                  <!-- skills da análise da IA: verde atende, âmbar em parte, laranja/vermelho não atende -->
                  <ItemsControl Grid.Row="2" Grid.Column="2" Margin="0,5,0,0" ItemsSource="{Binding Assessment, Converter={x:Static local:Palette.SkillPills}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="local:SkillPill">
                        <Border Classes="pill" Classes.good="{Binding IsGood}" Classes.partial="{Binding IsPartial}" Classes.bad="{Binding IsBad}" ToolTip.Tip="{Binding Tip}" Margin="0,0,4,3">
                          <TextBlock Text="{Binding Text}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="JobsEmpty" Text="Carregando…" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <Border Grid.Column="2" Classes="card">
          <ScrollViewer>
            <StackPanel Spacing="10">
              <SelectableTextBlock x:Name="DetailTitle" Classes="h2" FontSize="18" TextWrapping="Wrap" Text="Selecione uma vaga" />
              <Border x:Name="DetailStatus" Classes="badge" HorizontalAlignment="Left" IsVisible="False">
                <TextBlock x:Name="DetailStatusText" FontSize="12" FontWeight="SemiBold" />
              </Border>
              <SelectableTextBlock x:Name="DetailMeta" Classes="muted" TextWrapping="Wrap" />
              <WrapPanel x:Name="JobButtons" IsVisible="False">
                <Button x:Name="OpenJobButton" Content="Abrir vaga" Margin="0,0,8,8"  Classes="icon" Tag="&#xE8A7;"/>
                <Button x:Name="CopyJobButton" Content="Copiar vaga" Margin="0,0,8,8"  Classes="icon" Tag="&#xE8C8;"/>
                <Button x:Name="AppliedButton" Classes="icon primary" Content="Marcar aplicada" Margin="0,0,8,8"  Tag="&#xE73E;"/>
                <Button x:Name="SavedButton" Content="Salvar" Margin="0,0,8,8"  Classes="icon" Tag="&#xE734;"/>
                <Button x:Name="IgnoredButton" Classes="icon danger" Content="Ignorar" Margin="0,0,8,8"  Tag="&#xE711;"/>
                <Button x:Name="WorthButton" Content="Mover para revisão" Margin="0,0,8,8"  Classes="icon" Tag="&#xE7B3;"/>
                <Button x:Name="LetterTxtButton" Content="Carta em TXT" Margin="0,0,8,8"  Classes="icon" Tag="&#xE8A5;"/>
                <Button x:Name="LetterPdfButton" Content="Carta em PDF" Margin="0,0,8,8"  Classes="icon" Tag="&#xEA90;"/>
              </WrapPanel>
              <Border Classes="notice" IsVisible="{Binding #EmailPanel.IsVisible}">
                <StackPanel x:Name="EmailPanel" IsVisible="False" Spacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Candidatura por e-mail" Classes="h2" />
                    <local:HelpMark Text="Nada é enviado sem você confirmar. Os contatos foram achados no texto da vaga: confira se são da empresa. O e-mail leva a carta e o currículo em PDF." />
                  </StackPanel>
                  <StackPanel x:Name="EmailList" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="EmailSendButton" Classes="icon primary" Content="Enviar por e-mail…"  Tag="&#xE715;"/>
                    <Button x:Name="EmailCancelButton" Content="Cancelar" IsVisible="False" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <StackPanel x:Name="DetailSections" Spacing="14" />
              <TextBlock x:Name="DescriptionHeading" Text="Descrição da vaga" Classes="h2" FontSize="16" Margin="0,6,0,0" IsVisible="False" />
              <SelectableTextBlock x:Name="DetailBody" TextWrapping="Wrap" LineHeight="21" />
              <StackPanel x:Name="DetailLetter" Spacing="6" Margin="0,6,0,0" />
              <StackPanel Spacing="6" IsVisible="{Binding #JobButtons.IsVisible}">
                <TextBlock Text="Anotações" Classes="h2" />
                <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />
                <Button x:Name="NotesSaveButton" Content="Salvar anotação" HorizontalAlignment="Left"  Classes="icon" Tag="&#xE74E;"/>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>

    <!-- Barra de título própria (a do Windows foi removida: WindowDecorations="BorderOnly"). Arrastar move a janela; duplo clique maximiza. -->
    <Border x:Name="SidebarDrag" Grid.Column="0" Height="18" VerticalAlignment="Top" Background="Transparent" />
    <Grid x:Name="TitleBar" Grid.Column="1" Grid.Row="0" ColumnDefinitions="*,Auto" Background="Transparent">
      <Border x:Name="TitleDrag" Background="Transparent" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <!-- Guias: na barra de título, à vista em qualquer página -->
        <Button x:Name="GuidesButton" Classes="caption guides" AutomationProperties.Name="Guias de configuração" ToolTip.Tip="Guias de configuração">
          <!-- vetor, e não glifo: o traço fino da fonte de ícones saía apagado e com franjas coloridas -->
          <PathIcon Width="18" Height="18"
                    Data="M11,18H13V16H11Z M12,2C6.48,2 2,6.48 2,12S6.48,22 12,22 22,17.52 22,12 17.52,2 12,2Z M12,20C7.59,20 4,16.41 4,12S7.59,4 12,4 20,7.59 20,12 16.41,20 12,20Z M12,6C9.79,6 8,7.79 8,10H10C10,8.9 10.9,8 12,8S14,8.9 14,10C14,12 11,11.75 11,15H13C13,12.75 16,12.5 16,10 16,7.79 14.21,6 12,6Z" />
        </Button>
        <!-- separa os guias dos controles da janela -->
        <Border Width="1" Height="16" Margin="6,0" VerticalAlignment="Center" Background="{DynamicResource CardBorder}" />
        <Button x:Name="MinButton" Classes="caption" Content="&#xE921;" ToolTip.Tip="Minimizar" />
        <Button x:Name="MaxButton" Classes="caption" Content="&#xE922;" ToolTip.Tip="Maximizar" />
        <Button x:Name="CloseButton" Classes="caption close" Content="&#xE8BB;" ToolTip.Tip="Fechar para a bandeja" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
