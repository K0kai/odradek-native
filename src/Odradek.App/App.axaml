<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Odradek.App"
             x:Class="Odradek.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBg" Color="#F3F4F7" />
          <SolidColorBrush x:Key="SidebarBg" Color="#E9EBF0" />
          <SolidColorBrush x:Key="CardBg" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#DCDFE6" />
          <SolidColorBrush x:Key="Muted" Color="#667085" />
          <SolidColorBrush x:Key="Accent" Color="#2F6FED" />
          <SolidColorBrush x:Key="AccentHover" Color="#2559C4" />
          <SolidColorBrush x:Key="AccentSoft" Color="#E3ECFF" />
          <SolidColorBrush x:Key="HoverBg" Color="#E0E3EA" />
          <SolidColorBrush x:Key="Danger" Color="#C0392B" />
          <SolidColorBrush x:Key="Success" Color="#1E8A5A" />
          <SolidColorBrush x:Key="Warning" Color="#B7791F" />
          <SolidColorBrush x:Key="SuccessSoft" Color="#DDF3E8" />
          <SolidColorBrush x:Key="WarningSoft" Color="#FBEFD5" />
          <SolidColorBrush x:Key="DangerSoft" Color="#FBE3E0" />
          <SolidColorBrush x:Key="NeutralSoft" Color="#E6E8EE" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBg" Color="#0A0A0C" />
          <SolidColorBrush x:Key="SidebarBg" Color="#0E0E10" />
          <SolidColorBrush x:Key="CardBg" Color="#141417" />
          <SolidColorBrush x:Key="CardBorder" Color="#232328" />
          <SolidColorBrush x:Key="Muted" Color="#8E95A3" />
          <SolidColorBrush x:Key="Accent" Color="#5B93FF" />
          <SolidColorBrush x:Key="AccentHover" Color="#7AA7FF" />
          <SolidColorBrush x:Key="AccentSoft" Color="#16223B" />
          <SolidColorBrush x:Key="HoverBg" Color="#1D1D21" />
          <SolidColorBrush x:Key="Danger" Color="#F07167" />
          <SolidColorBrush x:Key="Success" Color="#4CC38A" />
          <SolidColorBrush x:Key="Warning" Color="#E5B454" />
          <SolidColorBrush x:Key="SuccessSoft" Color="#11271D" />
          <SolidColorBrush x:Key="WarningSoft" Color="#2A2411" />
          <SolidColorBrush x:Key="DangerSoft" Color="#2B1614" />
          <SolidColorBrush x:Key="NeutralSoft" Color="#1E1E23" />
        </ResourceDictionary>
        <!-- Dracula: escuro com fundos de tom vinho, vermelho como destaque e branco quente no texto (o laranja em Danger não se confunde com o destaque) -->
        <ResourceDictionary x:Key="{x:Static local:Palette.Dracula}">
          <SolidColorBrush x:Key="AppBg" Color="#0E0809" />
          <SolidColorBrush x:Key="SidebarBg" Color="#130A0C" />
          <SolidColorBrush x:Key="CardBg" Color="#1B0F12" />
          <SolidColorBrush x:Key="CardBorder" Color="#3A1A20" />
          <SolidColorBrush x:Key="Muted" Color="#B39CA1" />
          <SolidColorBrush x:Key="Accent" Color="#E5323F" />
          <SolidColorBrush x:Key="AccentHover" Color="#F2525E" />
          <SolidColorBrush x:Key="AccentSoft" Color="#3D1117" />
          <SolidColorBrush x:Key="HoverBg" Color="#26151A" />
          <SolidColorBrush x:Key="Danger" Color="#FF7A59" />
          <SolidColorBrush x:Key="Success" Color="#5FD38D" />
          <SolidColorBrush x:Key="Warning" Color="#EBB34E" />
          <SolidColorBrush x:Key="SuccessSoft" Color="#12261B" />
          <SolidColorBrush x:Key="WarningSoft" Color="#2B2210" />
          <SolidColorBrush x:Key="DangerSoft" Color="#34170F" />
          <SolidColorBrush x:Key="NeutralSoft" Color="#241619" />
          <!-- O Fluent só aceita paletas claro/escuro; o realce dos controles dele (foco, caixas marcadas, seleção) vira vermelho por aqui -->
          <Color x:Key="SystemAccentColor">#E5323F</Color>
          <Color x:Key="SystemAccentColorLight1">#F2525E</Color>
          <Color x:Key="SystemAccentColorLight2">#F77882</Color>
          <Color x:Key="SystemAccentColorLight3">#FA9AA2</Color>
          <Color x:Key="SystemAccentColorDark1">#C42532</Color>
          <Color x:Key="SystemAccentColorDark2">#9E1B26</Color>
          <Color x:Key="SystemAccentColorDark3">#78141D</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Escuro de verdade: as superfícies do próprio Fluent (listas suspensas, menus, caixas de texto, calendário) usam o mesmo preto do app, não o cinza #202020 padrão -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" RegionColor="#0A0A0C" ChromeLow="#0A0A0C" ChromeMediumLow="#141417" ChromeMedium="#141417"
                               ChromeHigh="#3A3A41" ListLow="#1A1A1E" ListMedium="#222227" AltHigh="#0A0A0C" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter, sans-serif" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{DynamicResource AppBg}" />
    </Style>

    <!-- Tipografia -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="SelectableTextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBlock.glyph"><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" /><Setter Property="FontSize" Value="16" /><Setter Property="VerticalAlignment" Value="Center" /></Style>

    <!-- Cartões -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.notice">
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Botões -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    </Style>
    <!-- Botão discreto: sem fundo nem borda, texto pequeno; "ready" o destaca (ex.: atualização pronta) -->
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="Button.quiet:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <!-- Botões da barra de título própria (minimizar, maximizar, fechar) -->
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}" /></Style>
    <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Style>
    <Style Selector="Button.quiet.ready, Button.quiet.link"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentHover}" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource AccentHover}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Opacity" Value="0.5" /></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Opacity" Value="0.45" /></Style>
    <!-- Botão com ícone: o texto continua sendo o Content (código e testes seguem lendo "Salvar", "Ignorar"…); o glifo vem de Tag -->
    <Style Selector="Button.icon">
      <Setter Property="ContentTemplate">
        <DataTemplate x:DataType="x:String">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="glyph" FontSize="14" Text="{Binding $parent[Button].Tag}" />
            <TextBlock Text="{Binding}" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </Setter>
    </Style>
    <!-- Entrada dos guias na barra de título: um botão dos controles da janela, com o "?" em círculo na cor do tema -->
    <Style Selector="Button.caption.guides"><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button.caption.guides:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.page"><Setter Property="Padding" Value="10,4" /></Style>
    <!-- Marcador de ajuda (?): círculo pequeno ao lado do que ele explica -->
    <Style Selector="Button.help">
      <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="9" /><Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Muted}" /><Setter Property="Foreground" Value="{DynamicResource Muted}" />
      <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.help:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Campos -->
    <Style Selector="TextBox, ComboBox"><Setter Property="CornerRadius" Value="6" /></Style>

    <!-- Filtros: cada campo é uma "pílula" (borda e fundo no Border.field) com um ícone à frente e o controle sem moldura dentro -->
    <Style Selector="Border.field">
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,0,6,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="BorderBrush" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="Border.field:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Border.field:focus-within"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Style>
    <Style Selector="Border.field.pager"><Setter Property="Padding" Value="2" /></Style>
    <Style Selector="Border.field > StackPanel, Border.field > Grid"><Setter Property="VerticalAlignment" Value="Center" /></Style>

    <Style Selector="TextBox.bare">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0,6" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement, TextBox.bare:focus:pointerover /template/ Border#PART_BorderElement, TextBox.bare:disabled /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ComboBox.bare, CalendarDatePicker.bare">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0,6,4,6" />
    </Style>
    <Style Selector="ComboBox.bare:pointerover /template/ Border#Background, ComboBox.bare:pressed /template/ Border#Background, ComboBox.bare:focus /template/ Border#Background, ComboBox.bare:focus-visible /template/ Border#Background">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="CalendarDatePicker.bare /template/ Border">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- O botão do calendário fica como um ícone discreto no fim do campo (o padrão é uma caixa grande com o "24") -->
    <Style Selector="CalendarDatePicker.bare /template/ Button#PART_Button">
      <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="Padding" Value="3" /><Setter Property="MinWidth" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="CalendarDatePicker.bare /template/ Button#PART_Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="CalendarDatePicker.bare /template/ Button#PART_Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}" /></Style>
    <Style Selector="CalendarDatePicker.bare /template/ TextBox">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="CalendarDatePicker.bare /template/ TextBox:pointerover /template/ Border#PART_BorderElement, CalendarDatePicker.bare /template/ TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.tiny">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" /><Setter Property="FontSize" Value="10" />
      <Setter Property="Width" Value="24" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tiny /template/ ContentPresenter#PART_ContentPresenter, Button.page[Tag=glyph] /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.tiny:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBg}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <!-- Botões de página com setas de ícone -->
    <Style Selector="Button.page[Tag=glyph]">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" /><Setter Property="FontSize" Value="12" />
      <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" /><Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="8" />
      <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.page[Tag=glyph]:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}" /></Style>

    <!-- Menu lateral -->
    <Style Selector="ListBox.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}" /></Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- Listas de cartões (vagas, fila, logs) -->
    <Style Selector="ListBox.cards"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="ListBox.cards ListBoxItem">
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Margin" Value="0,0,8,6" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="{DynamicResource CardBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /><BrushTransition Property="BorderBrush" Duration="0:0:0.12" /></Transitions>
      </Setter>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <Style Selector="ListBox.cards ListBoxItem">
      <Style.Animations>
        <Animation Duration="0:0:0.22" FillMode="Both">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="6" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}" /></Style>
    <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoft}" /><Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <!-- Lista de vagas densa: linhas separadas por divisórias, sem cartões -->
    <Style Selector="ListBox.rows"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="ListBox.rows ListBoxItem">
      <Setter Property="Padding" Value="8,9" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.14" /></Transitions></Setter>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.6" /></Transitions></Setter>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource HoverBg}" /></Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></Style>
    <!-- Vaga que acabou de chegar: entra com o fundo realçado e esmaece quando a classe sai -->
    <Style Selector="ListBox.rows ListBoxItem.fresh /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentSoft}" /></Style>

    <!-- Pílulas de skills (contornadas) e botões compactos da linha -->
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style Selector="Border.pill > TextBlock"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Border.pill.good"><Setter Property="BorderBrush" Value="{DynamicResource Success}" /></Style>
    <Style Selector="Border.pill.good > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Success}" /></Style>
    <Style Selector="Border.pill.partial"><Setter Property="BorderBrush" Value="{DynamicResource Warning}" /></Style>
    <Style Selector="Border.pill.partial > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Warning}" /></Style>
    <Style Selector="Border.pill.bad"><Setter Property="BorderBrush" Value="{DynamicResource Danger}" /></Style>
    <Style Selector="Border.pill.bad > TextBlock"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
    <Style Selector="Button.row"><Setter Property="MinHeight" Value="0" /><Setter Property="Height" Value="24" /><Setter Property="Padding" Value="10,0" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="Button.row.ghost"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Muted}" /></Style>
    <Style Selector="Button.row.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource Danger}" /></Style>
    <Style Selector="ListBox.nav ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>

    <Style Selector="ListBox.log ListBoxItem"><Setter Property="Padding" Value="10,3" /><Setter Property="Margin" Value="0" /><Setter Property="CornerRadius" Value="4" /></Style>

    <!-- Troca de tela: a tela nova aparece com um fade curto (a opacidade é zerada e devolvida em MainWindow.Navigate) -->
    <Style Selector="Control.page">
      <Setter Property="Transitions">
        <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.18" /></Transitions>
      </Setter>
    </Style>

    <!-- Abas -->
    <Style Selector="TabItem"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="14,8" /></Style>

    <Style Selector="ProgressBar"><Setter Property="Background" Value="{DynamicResource NeutralSoft}" /><Setter Property="Foreground" Value="{DynamicResource Accent}" /><Setter Property="Height" Value="8" /><Setter Property="MinHeight" Value="8" /><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="ProgressBar /template/ Border#PART_Indicator"><Setter Property="CornerRadius" Value="4" /></Style>
    <Style Selector="Expander"><Setter Property="CornerRadius" Value="8" /></Style>
  </Application.Styles>
</Application>
